+    # ---- Material de firma de la Trusted List -------------------------------
+    #
+    # POR QUE ESTAS TRES FUNCIONES
+    #
+    # El codigo original hacia, en cuatro sitios distintos:
+    #
+    #     der = open(cfgserv.cert_UT, "rb").read()
+    #     cert = x509.load_der_x509_certificate(der).public_bytes(PEM)
+    #     ...
+    #     key = open(cfgserv.priv_key_UT, "rb").read()
+    #
+    # Es decir: daba por hecho que el certificado esta en DER y pasaba la clave
+    # como bytes crudos. signxml hace load_pem_private_key() sobre lo que le
+    # llegue, asi que unos bytes DER fallan ahi. El resultado era que la firma
+    # de la Trusted List no funcionaba, y el fallo aparecia dentro de signxml,
+    # lejos del sitio donde estaba el problema.
+    #
+    # Estas funciones aceptan PEM o DER, dicen que formato encontraron cuando no
+    # pueden con ninguno, y devuelven objetos ya cargados en vez de bytes.
+
+    @staticmethod
+    def _leer(ruta, que):
+        try:
+            with open(ruta, "rb") as f:
+                return f.read()
+        except IOError as e:
+            raise RuntimeError(
+                "no se pudo leer %s en '%s': %s. "
+                "Se emite con ecosistema/scripts/emitir-firmante-tl.sh"
+                % (que, ruta, e)
+            )
+
+    @staticmethod
+    def cargar_cert_firma():
+        """Certificado del firmante de la TSL, en PEM (bytes). Acepta PEM o DER.
+
+        Devuelve SOLO la hoja, nunca la cadena, y eso es deliberado. signxml
+        escribe una entrada <xades:Cert> en SigningCertificateV2 por cada
+        certificado que reciba, pero al verificar compara TODAS esas entradas
+        contra el primer certificado del KeyInfo. Con la cadena metida ahi, la
+        firma que produce este codigo la rechaza su propio verificador.
+
+        Quien valide necesita la sub-CA, claro. La consigue por la extension
+        AIA caIssuers de esta misma hoja, que apunta a /pki/ca/tl.crt. Para eso
+        existe AIA: para no tener que meter la cadena dentro de cada firma.
+        """
+        datos = ConfService._leer(ConfService.cert_UT, "el certificado de firma")
+        try:
+            cert = x509.load_pem_x509_certificate(datos, default_backend())
+        except ValueError:
+            try:
+                cert = x509.load_der_x509_certificate(datos, default_backend())
+            except ValueError:
+                raise RuntimeError(
+                    "'%s' no es un certificado ni en PEM ni en DER"
+                    % ConfService.cert_UT
+                )
+        return cert.public_bytes(encoding=serialization.Encoding.PEM)
+
+    @staticmethod
+    def cargar_clave_firma():
+        """Clave privada del firmante, ya cargada. Acepta PEM o DER."""
+        datos = ConfService._leer(ConfService.priv_key_UT, "la clave de firma")
+        try:
+            return serialization.load_pem_private_key(
+                datos, password=None, backend=default_backend()
+            )
+        except ValueError:
+            try:
+                return serialization.load_der_private_key(
+                    datos, password=None, backend=default_backend()
+                )
+            except ValueError:
+                raise RuntimeError(
+                    "'%s' no es una clave privada ni en PEM ni en DER"
+                    % ConfService.priv_key_UT
+                )
+
+    @staticmethod
+    def metodo_firma(clave):
+        """SignatureMethod que corresponde a la clave, en vez de uno fijo.
+
+        El codigo original pedia ECDSA_SHA256 siempre, aunque la clave
+        instalada fuera RSA. Deducirlo de la clave elimina de raiz esa clase de
+        error: no hay dos sitios que puedan discrepar.
+        """
+        if isinstance(clave, ec.EllipticCurvePrivateKey):
+            return algorithms.SignatureMethod.ECDSA_SHA256
+        if isinstance(clave, rsa.RSAPrivateKey):
+            return algorithms.SignatureMethod.RSA_SHA256
+        raise RuntimeError(
+            "tipo de clave no soportado para firmar la TSL: %s" % type(clave).__name__
+        )
+
 
