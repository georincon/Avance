+def _new_oid4vp_nonce():
+    """
+    Genera un nonce nuevo para cada intento de login del operador.
+
+    Antes era la constante `hiCV7lZi5qAeCy7NFzUWSR4iCfSmRb99HfIvCkPaCLc=`
+    escrita en el código y reutilizada en todas las sesiones. Un nonce fijo
+    anula su única función —ligar la respuesta a esta petición concreta— y
+    convierte el login en reproducible con una respuesta capturada. Importa
+    especialmente aquí: el operador del TLP es la cuenta más privilegiada del
+    ecosistema, la que firma las Trusted Lists.
+    """
+    return secrets.token_urlsafe(32)
+
+
+def _nonce_for(session_id=None):
+    """
+    Recupera el nonce de esta sesión.
+
+    Se guarda en dos sitios porque hay dos caminos de recuperación: same-device
+    llega con `session_id` y lee de `oid4vp_requests` (estado de servidor), y
+    cross-device sólo dispone de la cookie de Flask.
+    """
+    if session_id and session_id in oid4vp_requests:
+        stored = oid4vp_requests[session_id].get("nonce")
+        if stored:
+            return stored
+    return session.get("oid4vp_nonce")
+
