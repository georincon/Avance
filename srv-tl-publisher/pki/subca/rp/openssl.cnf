# Generado por crear-pki.sh — no editar a mano.
[ ca ]
default_ca = CA_default

[ CA_default ]
dir               = /home/geovani/Workspace/wallet/ecosistema/pki/subca/rp
certs             = $dir/certs
crl_dir           = $dir/crl
new_certs_dir     = $dir/newcerts
database          = $dir/index.txt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
RANDFILE          = $dir/private/.rand

private_key       = $dir/private/ca.key.pem
certificate       = $dir/certs/ca.cert.pem

crl               = $dir/crl/rp.crl
default_crl_days  = 1
default_md        = sha256
default_days      = 825

name_opt          = ca_default
cert_opt          = ca_default
preserve          = no
policy            = politica_flexible
unique_subject    = no
copy_extensions   = none

[ politica_flexible ]
countryName             = optional
stateOrProvinceName     = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[ req ]
default_bits        = 2048
distinguished_name  = req_dn
string_mask         = utf8only
default_md          = sha256
prompt              = no

[ req_dn ]
C  = CO
O  = Civica EUDI
CN = placeholder

# ─── Extensiones ────────────────────────────────────────────────────────────
[ v3_raiz ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical, CA:true, pathlen:1
keyUsage               = critical, keyCertSign, cRLSign

[ v3_subca ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical, CA:true, pathlen:0
keyUsage               = critical, keyCertSign, cRLSign
authorityInfoAccess    = OCSP;URI:https://civica-desarrollo.avance.org.co/pki/ocsp, caIssuers;URI:https://civica-desarrollo.avance.org.co/pki/ca/root.crt
crlDistributionPoints  = URI:https://civica-desarrollo.avance.org.co/pki/crl/root.crl

[ v3_crl ]
authorityKeyIdentifier = keyid:always
