# Copia a .env (levantar.sh lo hace solo la primera vez).
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=andes-scd
# El par OAuth2 de la wallet: el mismo que va en business-logic/.../RQESConfigImpl.kt de la app.
CLIENT_ID=wallet-client
CLIENT_SECRET=andes-secreto-de-pruebas
# Direcciones de retorno que se aceptan (RQES_DEEPLINK de la app).
REDIRECT_URIS=rqes://oauth/callback
# Como se identifica el firmante: "pid" (presenta su PID desde la wallet) o "pin" (documento + PIN, solo pruebas).
AUTENTICACION=pid
# Instancia del verifier que pide el PID (verifiers/_comun/levantar.sh firma).
VERIFIER_INSTANCIA=firma
