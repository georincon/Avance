                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notaria-issuer/api/v1/ordenes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "notaria-issuer",
                "api",
                "v1",
                "ordenes"
              ],
              "query": []
            },
            "description": "Misma `referencia` y mismos datos: **200** y la misma orden, sin duplicarla. Así la plataforma puede reintentar sin riesgo si perdió la respuesta.\n\n**Resultado esperado:** HTTP 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"co.notaria.fe_de_vida\",\n  \"referencia\": \"{{referencia}}\",\n  \"datos\": {\n    \"titular_nombre\": \"Ana María Pérez Gómez\",\n    \"titular_documento\": \"1020304050\",\n    \"medio_identificacion\": \"Cédula de ciudadanía\",\n    \"entidad_destino\": \"Colpensiones\",\n    \"vigente_hasta\": \"2027-12-31\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
