# Plantilla de .env. ./levantar.sh la copia si no existe (y rellena los "generar").

# Dónde se publica: https://DOMINIO/PREFIJO/ (también es su credential_issuer).
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=eps

# Quién es: va en su CA, en el registro del tl-publisher, en las credenciales y en
# el certificado de su verifier (la wallet lo muestra). Ficticia a propósito: no
# se usa la marca de ninguna EPS real.
EPS_NOMBRE="EPS Salud Avance"
PAIS=CO

# Contraseña de administración (/eps/admin): quien la tenga registra médicos.
# Los médicos NO tienen contraseña: entran al portal médico con su wallet.
ADMIN_CLAVE=generar

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>.
VERIFIER_INSTANCIA=eps
PROPOSITO="Identificarte como afiliado, o comprobar el carné o la historia clínica de un paciente que atiendes"

# Capa de confianza: dónde se registra (lista QEAA) y a quién pregunta si la WIA
# de una wallet es de un wallet-provider de confianza.
TL_PUBLISHER_URL=https://civica-desarrollo.avance.org.co/tl-publisher
TRUST_VALIDATOR_URL=https://civica-desarrollo.avance.org.co/trust
# Clave de operador del tl-publisher para registrarse sola. Vacía: TL_OPERATOR_KEY de
# ../../srv-tl-publisher/docker-compose/.env si existe.
CLAVE_OPERADOR=
