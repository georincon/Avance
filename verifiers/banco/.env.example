# Plantilla de .env. ./levantar.sh la copia si no existe.

# Dónde se publica: https://DOMINIO/PREFIJO/
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=banco

# Cómo se llama el banco (en la página y en el certificado de su verifier, que la
# wallet le muestra al usuario). Entre comillas si lleva espacios.
NOMBRE_BANCO="NUBankCivica"

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>.
VERIFIER_INSTANCIA=banco
# Para qué pide los datos: va en el certificado de registro de su verifier y la
# wallet lo muestra. Solo se usa al crear la instancia del verifier.
PROPOSITO="Identificarte para entrar a tu banca en línea o abrir una cuenta"
