# Plantilla de .env. ./levantar.sh la copia si no existe.

# Dónde se publica: https://DOMINIO/PREFIJO/
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=acceso

# Quién controla el acceso (en la página y en el certificado de su verifier, que la wallet muestra a la persona).
NOMBRE_ENTIDAD="Edificio Cumbre"

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>.
VERIFIER_INSTANCIA=acceso
# Para qué pide los datos: va en el certificado de registro de su verifier y la wallet lo muestra.
# Solo se usa al crear la instancia del verifier (después se cambia en ../_comun/instancias/acceso/.env).
PROPOSITO="Comprobar quién eres al ingresar al edificio: se muestran tu foto, tu nombre y tu documento al personal de portería. No se guarda la foto."
