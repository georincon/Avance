# Plantilla de .env. ./levantar.sh la copia si no existe.

# Dónde se publica: https://DOMINIO/PREFIJO/
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=contratacion

# Quién verifica (en la página y en el certificado de su verifier, que la wallet muestra a la persona).
NOMBRE_EMPLEADOR="Corporación Avance"

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>.
VERIFIER_INSTANCIA=contratacion
# Para qué pide los datos: va en el certificado de registro de su verifier y la wallet lo muestra.
# Solo se usa al crear la instancia del verifier.
PROPOSITO="Comprobar el nivel de formación académica de las personas candidatas a un empleo. No se guarda ningún dato."
