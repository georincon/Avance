# Plantilla de .env. ./levantar.sh la copia si no existe (y rellena los "generar").

# Dónde se publica: https://DOMINIO/PREFIJO/ (también es su credential_issuer).
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=aerolinea

# Quién es. El nombre va en su CA, en el registro del tl-publisher, en los tiquetes y en el certificado de su
# verifier (la wallet lo muestra). Aerolínea ficticia: no se usa la marca de ninguna aerolínea real.
AEROLINEA_NOMBRE="Páramo Air"
# Código de la aerolínea en los números de vuelo (PMO 4521).
AEROLINEA_CODIGO=PMO
PAIS=CO

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>. Con él identifica al pasajero que compra y comprueba
# tiquete y documento en el embarque.
VERIFIER_INSTANCIA=aerolinea
PROPOSITO="Verificar tu identidad como pasajero (nombre, documento, fecha de nacimiento y foto) para venderte un tiquete y comprobarlo en el embarque. Los datos no se usan para otra cosa."

# Capa de confianza: dónde se registra (lista QEAA) y a quién pregunta si la WIA de una wallet es de un wallet-provider
# de confianza.
TL_PUBLISHER_URL=https://civica-desarrollo.avance.org.co/tl-publisher
TRUST_VALIDATOR_URL=https://civica-desarrollo.avance.org.co/trust
# Clave de operador del tl-publisher para registrarse sola. Vacía: TL_OPERATOR_KEY de
# ../../srv-tl-publisher/docker-compose/.env si existe.
CLAVE_OPERADOR=
