# Plantilla de instancias/<nombre>/.env. ./levantar.sh <nombre> la copia y rellena
# INSTANCIA, PREFIJO y los valores "generar". Si después aparecen variables nuevas
# aquí, levantar.sh se las agrega al .env de cada instancia.

# --- Dónde se publica ------------------------------------------------------------
# Dominio del ecosistema Avance (el del proxy único srv-nw-nginx): https://DOMINIO/PREFIJO/
DOMINIO=civica-desarrollo.avance.org.co
INSTANCIA=
PREFIJO=

# --- Quién es el verifier ----------------------------------------------------------
# Va en el certificado de acceso (CN y O) y en el certificado de registro, y la wallet
# se lo muestra al usuario antes de compartir datos. Entre comillas si llevan espacios.
VERIFIER_NOMBRE="Verifier de prueba"
VERIFIER_PAIS=CO
VERIFIER_CORREO=
# Para qué pide los datos (intended use). También lo ve el usuario.
VERIFIER_PROPOSITO="Comprobar la identidad de la persona"

# Credenciales que declara su certificado de registro (separadas por comas, SD-JWT VC). Vacío = el PID.
# Ej.: WRPRC_VCTS=urn:eudi:academic:credential:1
WRPRC_VCTS=

# Cómo se identifica ante la wallet (client_id):
#   x509_hash     el hash del certificado de acceso. Es el que exige el perfil HAIP,
#                 que es el que la UI usa por defecto. Recomendado.
#   x509_san_dns  el dominio (SAN DNS del certificado). En la UI hay que elegir el
#                 perfil "openid4vp" en vez de "haip".
ESQUEMA_CLIENT_ID=x509_hash

# --- Cuánto guarda ---------------------------------------------------------------------
# El verifier guarda cada presentación en memoria, nunca en disco, y borra las más viejas
# que esto cada 30 min. Java Duration. Por defecto 10 días; un servicio que no debe guardar
# nada (la discoteca, o cualquier verifier de salud) usa PT5M.
CONSERVAR_PRESENTACIONES=P10D
# Cuánto vale una solicitud (el QR) antes de vencer.
VIGENCIA_SOLICITUD=PT6400M

# --- Capa de confianza ---------------------------------------------------------------
# De aquí salen el certificado de acceso (registro del verifier), la URL del
# trust-validator y qué documentos son PID, QEAA o PubEAA
# (/tl-api/v1/integracion/verifier.env).
TL_PUBLISHER_URL=https://civica-desarrollo.avance.org.co/tl-publisher
# Clave de operador del tl-publisher (TL_OPERATOR_KEY), para que levantar.sh registre el
# verifier solo. Vacía: se lee de srv-tl-publisher/docker-compose/.env (misma máquina);
# si tampoco, levantar.sh explica cómo pedir el certificado al operador.
CLAVE_OPERADOR=

# --- Secretos y versiones -----------------------------------------------------------
# Contraseña del keystore PKCS#12 con la clave de acceso (instancias/<n>/secretos/).
KEYSTORE_PASSWORD=generar
VERIFIER_ENDPOINT_VERSION=v0.12.0
VERIFIER_UI_VERSION=v0.13.0
