# Plantilla de .env. ./levantar.sh la copia si no existe.

# Dónde se publica: https://DOMINIO/PREFIJO/
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=migracion

# Quién controla el migracion (en la página y en el certificado de su verifier, que la wallet muestra a la persona).
NOMBRE_ENTIDAD="Migración Cívica"

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>.
VERIFIER_INSTANCIA=migracion
# Para qué pide los datos: va en el certificado de registro de su verifier y la wallet lo muestra.
# Solo se usa al crear la instancia del verifier (después se cambia en ../_comun/instancias/migracion/.env).
PROPOSITO="Control migratorio: comprobar que el pasaporte es auténtico, está vigente y es de quien lo presenta. Se muestran el retrato y los datos al funcionario; no se guardan."
