# Plantilla de .env. ./levantar.sh la copia si no existe.

# Dónde se publica: https://DOMINIO/PREFIJO/ (también es su credential_issuer).
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=universidad

# Quién es. El nombre va en su CA, en el registro del tl-publisher, en los
# documentos y en el certificado de su verifier (la wallet lo muestra).
# Entre comillas si llevan espacios.
UNIVERSIDAD_NOMBRE="Universidad Industrial de Santander"
FUNCIONARIO_NOMBRE="Registro y Control Académico"
PAIS=CO

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>. Con él
# identifica a quien hace un trámite y comprueba documentos que le presentan.
VERIFIER_INSTANCIA=universidad
PROPOSITO="Identificarte como estudiante activo para emitir tu carnet, o comprobar un carnet estudiantil"

# Capa de confianza: dónde se registra (lista PUBEAA) y a quién pregunta si la
# WIA de una wallet es de un wallet-provider de confianza.
TL_PUBLISHER_URL=https://civica-desarrollo.avance.org.co/tl-publisher
TRUST_VALIDATOR_URL=https://civica-desarrollo.avance.org.co/trust
# Clave de operador del tl-publisher para registrarse sola. Vacía: la de
# TL_OPERATOR_KEY de ../../srv-tl-publisher/docker-compose/.env si existe; si no, levantar.sh explica cómo pedir el alta.
CLAVE_OPERADOR=

# Sistema académico (la base de la UIS, la misma del issuer de credenciales académicas): de aquí sale
# quién es estudiante ACTIVO. Solo lectura.
ACADEMICO_URL=postgresql://uis_academic:uis_academic@postgres-uis-academic:5432/uis_academic

# Botón «Carnet Estudiantil» del issuer de la UIS (eudi-srv-issuer-pid-uis): el secreto con que firma el testigo del enlace
# (el mismo UIS_CARNET_SECRET de su docker-compose) y su URL pública, para saber a dónde volver.
UIS_HANDOFF_SECRET=
UIS_ISSUER_PUBLIC=https://civica-desarrollo.avance.org.co/uis-issuer
