# Plantilla de .env. ./levantar.sh la copia si no existe (y rellena los "generar").

# Dónde se publica: https://DOMINIO/PREFIJO/ (también es su credential_issuer).
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=gym

# Quién es: va en su CA, en el registro del tl-publisher, en las tarjetas y en el certificado de su
# verifier (la wallet lo muestra). Gimnasio ficticio a propósito: no se usa la marca de ninguno real.
GYM_NOMBRE="Cumbre Gym"
PAIS=CO

# Contraseña de administración (/gym/admin): aforo, socios (suspender, renovar) e historial de accesos.
ADMIN_CLAVE=generar

# Cuántas personas caben a la vez en cada sede. Con el aforo lleno, la entrada se niega.
AFORO_MAXIMO=60

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>. Identifica a quien se afilia (PID) y
# comprueba la tarjeta de socio en la entrada y en la salida.
VERIFIER_INSTANCIA=gym
PROPOSITO="Identificarte para afiliarte al gimnasio, o comprobar tu tarjeta de socio al entrar y al salir de la sede"

# Capa de confianza: dónde se registra (lista QEAA) y a quién pregunta si la WIA
# de una wallet es de un wallet-provider de confianza.
TL_PUBLISHER_URL=https://civica-desarrollo.avance.org.co/tl-publisher
TRUST_VALIDATOR_URL=https://civica-desarrollo.avance.org.co/trust
# Clave de operador del tl-publisher para registrarse sola. Vacía: TL_OPERATOR_KEY de
# ../../srv-tl-publisher/docker-compose/.env si existe.
CLAVE_OPERADOR=
