# Plantilla de .env. ./levantar.sh la copia si no existe.

# Dónde se publica: https://DOMINIO/PREFIJO/
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=discoteca

# El nombre del local: sale en la pantalla y en el certificado de su verifier
# (la wallet se lo muestra a quien escanea). Entre comillas si lleva espacios.
NOMBRE="Discoteca Neón"
# Edad mínima. El PID de la Registraduría trae age_equal_or_over para 18 y 21.
EDAD_MINIMA=18

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>.
VERIFIER_INSTANCIA=discoteca
# Para qué pide el dato: la wallet lo muestra. Solo se usa al crear el verifier.
PROPOSITO="Comprobar que eres mayor de edad para entrar. No se guarda ningún dato."
