# Plantilla de .env. ./levantar.sh la copia si no existe.

# Dónde se publica: https://DOMINIO/PREFIJO/
DOMINIO=civica-desarrollo.avance.org.co
PREFIJO=pensiones

# Quién verifica (en la página y en el certificado de su verifier, que la wallet muestra a la persona). Fondo ficticio.
NOMBRE_ENTIDAD="Fondo de Pensiones Horizonte"

# Su verifier (../_comun/instancias/<nombre>): verifier-<nombre>.
VERIFIER_INSTANCIA=pensiones
# Para qué pide los datos: va en el certificado de registro de su verifier y la wallet lo muestra.
# Solo se usa al crear la instancia del verifier (después se cambia en ../_comun/instancias/pensiones/.env).
PROPOSITO="Comprobar que sigues con vida (prueba de supervivencia) para mantener activa tu mesada pensional. Se usan tu fe de vida notarial y tu nombre y documento; no se guarda nada."
